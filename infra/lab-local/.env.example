# Laboratorio local — copiar a ".env" y completar. ".env" no se sube a Git.
# Generar valores: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

# Base de datos de Zabbix
ZBX_DB_PASSWORD=

# Grafana (usuario admin)
GRAFANA_ADMIN_PASSWORD=

# Usuario de Zabbix de solo lectura que usa Grafana (lo crea configurar-zabbix.py)
ZABBIX_API_USER=grafana
ZABBIX_API_PASSWORD=

# n8n: clave para cifrar credenciales guardadas y token del webhook de Zabbix
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_TOKEN=

# Token de API de Zabbix que usa n8n para reconocer eventos.
# No hay que completarlo: lo genera configurar-zabbix.py y lo agrega al final de .env.
# ZABBIX_N8N_TOKEN=
