# Variables para docker-compose.yml. Copiar a ".env" y completar.
# ".env" está ignorado por Git: NUNCA subir contraseñas reales.
# Generar secretos largos, por ejemplo:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --- Base de datos ---
DB_NAME=proyecto_taller
DB_USER=taller_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Aplicación ---
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Puerto publicado SOLO en 127.0.0.1 (Nginx de la VM hace de proxy)
APP_PORT=3000
# Procesos de Node dentro del contenedor (ajustar a las vCPU de la VM)
WEB_CONCURRENCY=2
DB_POOL_TOTAL=20
# 1 = no ejecutar los jobs programados (recordatorios de cita, no-show)
DISABLE_CRON=0
# Correo (decisión del 14-oct-2026): los códigos se envían por Brevo, que entrega a
# cualquier cliente sin dominio propio. La clave y el remitente los pone
# infra/vm-app/configurar-correo.sh, que la pide sin mostrarla. MAIL_FROM debe estar
# verificado en Brevo. Sin ninguna clave, la app no envía y deja el código en el log
# ("docker logs msmotos-app | grep DEV").
BREVO_API_KEY=
MAIL_FROM=
RESEND_API_KEY=

# --- Cuentas iniciales (docker compose run --rm seed) ---
# Mínimo 8 caracteres. Una cuenta sin contraseña no se crea.
SEED_ADMIN_EMAIL=admin@taller.com
SEED_ADMIN_PASSWORD=
SEED_RECEP_EMAIL=recepcion@taller.com
SEED_RECEP_PASSWORD=
# Usuario sintético del RPA (rol recepción)
SEED_RPA_EMAIL=rpa@taller.local
SEED_RPA_PASSWORD=
# Cliente sintético del RPA: cuenta del portal de clientes, con una moto y un servicio
# de prueba. Es la que usa el robot para medir la experiencia del cliente.
SEED_CLIENTE_RPA_EMAIL=cliente.rpa@taller.local
SEED_CLIENTE_RPA_PASSWORD=
