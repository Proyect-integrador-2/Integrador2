entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="&lt;b&gt;R1 / SW1&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;SSH n8n-net: reiniciar interfaz,&lt;br&gt;reactivar puerto, reload con respaldo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1250" y="470" width="230" height="80" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2e7d32;strokeWidth=2;fontSize=11;fontColor=#2e7d32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="&lt;font color=&#x27;#2e7d32&#x27;&gt;&lt;b&gt;Se recupera solo&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1d2330;" vertex="1" parent="1"><mxGeometry x="1250" y="215" width="230" height="24" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Telegram + correo&lt;/b&gt;&lt;br&gt;host, problema, severidad, hora,&lt;br&gt;acción y resultado (RNF-05)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#1f5fa8;fontSize=12;fontColor=#1d2330;" vertex="1" parent="1"><mxGeometry x="880" y="560" width="280" height="84" as="geometry"/></mxCell><mxCell id="c32" value="toda alerta, se haya&lt;br&gt;actuado o no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1f5fa8;strokeWidth=2;fontSize=11;fontColor=#1f5fa8;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="&lt;font color=&#x27;#2e7d32&#x27;&gt;&lt;b&gt;Se recupera solo&lt;/b&gt;&lt;/font&gt; · causa conocida y acción que no destruye nada&lt;br&gt;T01 contenedor detenido · T03 Nginx detenido · T03-W servicio Windows detenido&lt;br&gt;T09 interfaz de acceso caída · T09b puerto err-disabled · T11 equipo de red saturado &gt; 10 min" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;fontColor=#1d2330;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="790" width="700" height="80" as="geometry"/></mxCell><mxCell id="c34" value="&lt;font color=&#x27;#c62828&#x27;&gt;&lt;b&gt;Solo alerta&lt;/b&gt;&lt;/font&gt; · hay que investigar antes de actuar&lt;br&gt;T06–T08 CPU, RAM, disco (el PDF prohíbe ampliar recursos) · T09-G enlace de gestión&lt;br&gt;T02 contenedor unhealthy · T04–T05 app · T10 enlace saturado · T11b equipo sin respuesta&lt;br&gt;T12–T14 RPA · T15–T17 dominio" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffebee;strokeColor=#c62828;fontSize=11;fontColor=#1d2330;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="760" y="780" width="720" height="96" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Límites (RNF-10):&lt;/b&gt; primero la acción menor · máx. 3 intentos cada 10 min por objetivo · 1 reload por equipo por hora · si no se recupera, escala a una persona" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1d2330;" vertex="1" parent="1"><mxGeometry x="470" y="680" width="700" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>