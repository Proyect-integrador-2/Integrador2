<mxfile host="drawio"><diagram name="arquitectura-logica" id="arquitectura-logica"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1400" pageHeight="860" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;Arquitectura lógica&lt;/b&gt; · segmentación y tráfico permitido" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontColor=#1d2330;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="800" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Todo el tráfico entre VLAN pasa por R1 (router-on-a-stick): cada VLAN tiene su subinterfaz y su gateway .1. La ACL &lt;b&gt;ACL-USUARIOS-IN&lt;/b&gt; se aplica en la entrada de Gi0/0/1.20." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1d2330;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1300" height="20" as="geometry"/></mxCell><mxCell id="c5" value="Internet" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontColor=#1d2330;" vertex="1" parent="1"><mxGeometry x="600" y="70" width="200" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;R1&lt;/b&gt; · gateway .1 de cada VLAN&lt;br&gt;NAT/PAT · DHCP de la VLAN 20 · ACL" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#36393d;fontSize=12;fontColor=#1d2330;" vertex="1" parent="1"><mxGeometry x="560" y="195" width="280" height="60" as="geometry"/></mxCell><mxCell id="c7" value="NAT/PAT (overload) por Gi0/0/0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1f5fa8;strokeWidth=2;fontSize=11;fontColor=#1f5fa8;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.92;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="VLAN 40 · ADMINISTRACIÓN&lt;br&gt;&lt;font style=&#x27;font-weight:normal&#x27;&gt;10.10.40.0/24&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontColor=#1d2330;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="330" height="170" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;PC-ADMIN&lt;/b&gt; · 10.10.40.10&lt;br&gt;IP fija" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;fontColor=#1d2330;" vertex="1" parent="1"><mxGeometry x="70" y="400" width="270" height="50" as="geometry"/></mxCell><mxCell id="c10" value="VLAN 20 · USUARIOS&lt;br&gt;&lt;font style=&#x27;font-weight:normal&#x27;&gt;10.10.20.0/24 · DHCP .100–.200&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontColor=#1d2330;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="330" height="250" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;PC-CLIENTE&lt;/b&gt;&lt;br&gt;clientes y empleados del taller" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;fontColor=#1d2330;" vertex="1" parent="1"><mxGeometry x="70" y="640" width="270" height="70" as="geometry"/></mxCell><mxCell id="c12" value="&lt;font color=&#x27;#2e7d32&#x27;&gt;&lt;b&gt;✔ solo TCP 80/443&lt;/b&gt;&lt;/font&gt;&lt;br&gt;hacia las dos instancias&lt;br&gt;de MS Motos" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1d2330;" vertex="1" parent="1"><mxGeometry x="70" y="725" width="270" height="60" as="geometry"/></mxCell><mxCell id="c13" value="VLAN 99 · GESTIÓN&lt;br&gt;&lt;font style=&#x27;font-weight:normal&#x27;&gt;10.10.99.0/24&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontColor=#1d2330;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="1030" y="320" width="330" height="170" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;SW1&lt;/b&gt; · SVI 10.10.99.2&lt;br&gt;SSH y SNMP del switch" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;fontColor=#1d2330;" vertex="1" parent="1"><mxGeometry x="1060" y="400" width="270" height="50" as="geometry"/></mxCell><mxCell id="c15" value="VLAN 30 · SERVIDORES&lt;br&gt;&lt;font style=&#x27;font-weight:normal&#x27;&gt;10.10.30.0/24 · IP fijas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontColor=#1d2330;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;strokeWidth=2;container=0;" vertex="1" parent="1"><mxGeometry x="430" y="320" width="560" height="490" as="geometry"/></mxCell><mxCell id="c16" value="Proxmox · .10&lt;br&gt;&lt;font color=&#x27;#555555&#x27; style=&#x27;font-size:10px&#x27;&gt;panel de gestión :8006&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;fontColor=#1d2330;" vertex="1" parent="1"><mxGeometry x="460" y="390" width="240" height="62" as="geometry"/></mxCell><mxCell id="c17" value="vm-grafana · .13&lt;br&gt;&lt;font color=&#x27;#555555&#x27; style=&#x27;font-size:10px&#x27;&gt;5 dashboards&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;fontColor=#1d2330;" vertex="1" parent="1"><mxGeometry x="720" y="390" width="240" height="62" as="geometry"/></mxCell><mxCell id="c18" value="vm-zabbix · .12&lt;br&gt;&lt;font color=&#x27;#555555&#x27; style=&#x27;font-size:10px&#x27;&gt;monitoreo · único origen SNMP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;fontColor=#1d2330;" vertex="1" parent="1"><mxGeometry x="460" y="480" width="240" height="62" as="geometry"/></mxCell><mxCell id="c19" value="vm-n8n · .14&lt;br&gt;&lt;font color=&#x27;#555555&#x27; style=&#x27;font-size:10px&#x27;&gt;automatización&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;fontColor=#1d2330;" vertex="1" parent="1"><mxGeometry x="720" y="480" width="240" height="62" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;vm-app&lt;/b&gt; · .11&lt;br&gt;&lt;font color=&#x27;#555555&#x27; style=&#x27;font-size:10px&#x27;&gt;App Linux (Docker) · 80/443&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="460" y="610" width="240" height="62" as="geometry"/></mxCell><mxCell id="c21" value="vm-rpa · .15&lt;br&gt;&lt;font color=&#x27;#555555&#x27; style=&#x27;font-size:10px&#x27;&gt;cliente sintético&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;fontColor=#1d2330;" vertex="1" parent="1"><mxGeometry x="720" y="610" width="240" height="62" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;vm-app-win&lt;/b&gt; · .16&lt;br&gt;&lt;font color=&#x27;#555555&#x27; style=&#x27;font-size:10px&#x27;&gt;App Windows (servicio) · 80/443&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=12;fontColor=#1d2330;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="460" y="700" width="240" height="62" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;vm-dc&lt;/b&gt; · .17&lt;br&gt;&lt;font color=&#x27;#555555&#x27; style=&#x27;font-size:10px&#x27;&gt;&lt;font color=&#x27;#c62828&#x27;&gt;AD + DNS · no visible a usuarios&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;fontColor=#1d2330;" vertex="1" parent="1"><mxGeometry x="720" y="700" width="240" height="62" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Visibles para usuarios:&lt;/b&gt; solo las dos instancias de MS Motos (borde verde)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1d2330;" vertex="1" parent="1"><mxGeometry x="460" y="568" width="510" height="24" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2e7d32;strokeWidth=3;fontSize=11;fontColor=#2e7d32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="661"/><mxPoint x="400" y="641"/></Array></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2e7d32;strokeWidth=3;fontSize=11;fontColor=#2e7d32;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="415" y="689"/><mxPoint x="415" y="731"/></Array></mxGeometry></mxCell><mxCell id="c27" value="✘ bloqueado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c62828;strokeWidth=2;fontSize=11;fontColor=#c62828;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="✔ administración: acceso total · SSH solo desde la VLAN 40 (ACL-SSH-ADMIN)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1f5fa8;strokeWidth=2;fontSize=11;fontColor=#1f5fa8;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="290"/><mxPoint x="1195" y="290"/></Array></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#2e7d32&#x27;&gt;━━&lt;/font&gt; permitido para usuarios&lt;br&gt;&lt;font color=&#x27;#c62828&#x27;&gt;╌╌&lt;/font&gt; bloqueado por la ACL&lt;br&gt;&lt;font color=&#x27;#1f5fa8&#x27;&gt;━━&lt;/font&gt; administración" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1d2330;" vertex="1" parent="1"><mxGeometry x="1040" y="540" width="320" height="90" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Bloqueado para la VLAN 20:&lt;/b&gt; VLAN 40, VLAN 99, el resto de la VLAN 30 (incluido el controlador de dominio) y las IP del router en otras VLAN." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1d2330;" vertex="1" parent="1"><mxGeometry x="1040" y="640" width="320" height="70" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Por qué VLAN 99 y 999:&lt;/b&gt; la gestión del switch no comparte red con los usuarios, y la nativa de los trunks es la 999 (sin uso), no la 1: evita el salto de VLAN por doble etiquetado." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#1d2330;" vertex="1" parent="1"><mxGeometry x="1040" y="720" width="320" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>