        <mxCell id="vlan20" value="&lt;b&gt;VLAN 20 · Usuarios / Clientes&lt;/b&gt;&lt;br&gt;10.10.20.0/24 (propuesta)&lt;br&gt;&lt;br&gt;PC-CLIENTE&lt;br&gt;&lt;i&gt;Solo accede a la app (80/443)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
