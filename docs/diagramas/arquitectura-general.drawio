        <mxCell id="vlan10" value="&lt;b&gt;VLAN 10 · Administración&lt;/b&gt;&lt;br&gt;10.10.10.0/24 (propuesta)&lt;br&gt;&lt;br&gt;PC-ADMIN&lt;br&gt;&lt;i&gt;Acceso total a la infraestructura&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="260" height="120" as="geometry" />
