<mxfile host="app.diagrams.net">
  <diagram id="arquitectura-general" name="Arquitectura general">
    <mxGraphModel dx="1400" dy="1110" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Título -->
        <mxCell id="titulo" value="&lt;b&gt;Integrador II · Arquitectura general (versión inicial)&lt;/b&gt;&lt;br&gt;Servicios Digitales del Pacífico S.A. · Aplicación MS Motos" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="520" height="50" as="geometry" />
        </mxCell>

        <!-- Red física -->
        <mxCell id="internet" value="&lt;b&gt;Internet&lt;/b&gt;&lt;br&gt;(red de la universidad)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="610" y="20" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="router" value="&lt;b&gt;Router&lt;/b&gt; (equipo de la U)&lt;br&gt;NAT/PAT · ACL · SNMP&lt;br&gt;Router-on-a-stick" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
