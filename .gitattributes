# Se edita en Windows pero se ejecuta en Linux (VMs, contenedores):
# estos archivos deben quedar con fin de línea LF o fallan con "bad interpreter".
* text=auto
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.robot text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
Jenkinsfile text eol=lf

# Configuraciones de equipos Cisco (se pegan por consola)
red/**/*.txt text eol=crlf
*.ps1 text eol=crlf

# Binarios
*.pkt binary
*.png binary
*.jpg binary
*.pdf binary
